#!/usr/bin/env bash
set -euo pipefail

# annotate_with_vep.sh
#
# Annotate a VCF with Ensembl VEP and produce a useful TSV summary.
#
# Requirements:
#   - VEP installed
#   - bcftools installed
#   - tabix installed
#   - VEP cache for danio_rerio / GRCz11 installed locally, or use --cache dir
#
# Notes:
#   - VEP supports offline/cache annotation. By default it looks in $HOME/.vep
#     unless --dir_cache is specified. Offline/cache mode is recommended for
#     reproducibility and speed. ([ensembl.org](https://www.ensembl.org/info/docs/tools/vep/script/?utm_source=openai))

# ---------------- CONFIG ----------------
INPUT_VCF="/home/jgd/Documents/bioinformatics_working/data/snp_calling/gatk-ensembl/gatk-ensembl_variants.20260224.fixed.vcf.gz"
OUTBASE="/home/jgd/Documents/bioinformatics_working/data/output"

VEP_BIN="vep"
BCFTOOLS="bcftools"
TABIX="tabix"

SPECIES="danio_rerio"
ASSEMBLY="GRCz11"
CACHE_VERSION="115"

# Leave as empty string to use default VEP cache dir ($HOME/.vep)
VEP_CACHE_DIR=""
# Optional FASTA for VEP --fasta
VEP_FASTA="/home/jgd/Documents/bioinformatics_working/reference/Danio_rerio.GRCz11.dna_rm.primary_assembly.fa"

# Behavior
FORCE_OVERWRITE=0
FORKS=8
BUFFER_SIZE=5000
# ----------------------------------------

die() {
  echo "ERROR: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found in PATH"
}

need_cmd "$VEP_BIN"
need_cmd "$BCFTOOLS"
need_cmd "$TABIX"

[[ -f "$INPUT_VCF" ]] || die "INPUT_VCF not found: $INPUT_VCF"

if [[ ! -f "${INPUT_VCF}.tbi" && ! -f "${INPUT_VCF}.csi" ]]; then
  echo "Indexing input VCF with tabix: $INPUT_VCF"
  "$TABIX" -p vcf "$INPUT_VCF"
fi

TIMESTAMP="$(date +%Y%m%d_%H%M%S)"
OUTDIR="${OUTBASE%/}/vep_${TIMESTAMP}"
mkdir -p "$OUTDIR"
LOGFILE="${OUTDIR}/vep_${TIMESTAMP}.log"

ANNOTATED_VCF="${OUTDIR}/annotated.vep.vcf.gz"
ANNOTATED_TSV="${OUTDIR}/annotated.vep.summary.tsv"
CSQ_HEADER_TXT="${OUTDIR}/csq_header.txt"

log() {
  local ts
  ts="$(date '+%Y-%m-%d %H:%M:%S')"
  printf '%s %s\n' "$ts" "$*" | tee -a "$LOGFILE"
}

log "Run timestamp: $TIMESTAMP"
log "Input VCF: $INPUT_VCF"
log "Output dir: $OUTDIR"
log "Using VEP: $(command -v "$VEP_BIN")"
log "Species: $SPECIES"
log "Assembly: $ASSEMBLY"
log "Cache version: $CACHE_VERSION"
log "--------------------------------------------------"

VEP_ARGS=(
  --input_file "$INPUT_VCF"
  --output_file STDOUT
  --vcf
  --compress_output bgzip
  --species "$SPECIES"
  --assembly "$ASSEMBLY"
  --cache
  --offline
  --cache_version "$CACHE_VERSION"
  --fork "$FORKS"
  --buffer_size "$BUFFER_SIZE"
  --everything
  --allele_number
  --total_length
  --numbers
  --force_overwrite
)

if [[ -n "$VEP_CACHE_DIR" ]]; then
  VEP_ARGS+=(--dir_cache "$VEP_CACHE_DIR")
fi

if [[ -n "$VEP_FASTA" && -f "$VEP_FASTA" ]]; then
  VEP_ARGS+=(--fasta "$VEP_FASTA")
fi

if [[ ! -s "$ANNOTATED_VCF" || $FORCE_OVERWRITE -eq 1 ]]; then
  log "[1/3] Running VEP"
  "${VEP_BIN}" "${VEP_ARGS[@]}" > "$ANNOTATED_VCF" 2>>"$LOGFILE"
  "$TABIX" -p vcf "$ANNOTATED_VCF" >>"$LOGFILE" 2>&1
fi

log "[2/3] Capturing CSQ header"
"$BCFTOOLS" view -h "$ANNOTATED_VCF" | grep 'ID=CSQ' > "$CSQ_HEADER_TXT"

log "[3/3] Writing VEP summary table with bcftools +split-vep"
# Requires bcftools plugin split-vep; standard plugin for CSQ extraction. ([samtools.github.io](https://samtools.github.io/bcftools/howtos/plugin.split-vep.html?utm_source=openai))
"$BCFTOOLS" +split-vep "$ANNOTATED_VCF" \
  -d \
  -A tab \
  -f '%CHROM\t%POS\t%REF\t%ALT\t%FILTER\t%Consequence\t%IMPACT\t%SYMBOL\t%Gene\t%Feature\t%BIOTYPE\t%EXON\t%INTRON\t%HGVSc\t%HGVSp\t%Protein_position\t%Amino_acids\t%Codons\t%Existing_variation\n' \
  > "$ANNOTATED_TSV" 2>>"$LOGFILE"

log "--------------------------------------------------"
log "DONE"
log "Annotated VCF: $ANNOTATED_VCF"
log "Summary TSV:   $ANNOTATED_TSV"
log "CSQ header:    $CSQ_HEADER_TXT"
log "Logfile:       $LOGFILE"
